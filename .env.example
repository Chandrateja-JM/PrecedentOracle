# ═══════════════════════════════════════════════════════════
# PrecedentOracle — Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy this to .env and fill in your keys.

# ─── AI Provider (for Deep Identify + AI Search) ──────────
# Get at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# ─── Backend URL ──────────────────────────────────────────
VITE_API_URL=http://localhost:8000

# ─── Google Custom Search (for Google tab) ────────────────
# 1. https://programmablesearchengine.google.com → create engine
#    Add sites: indiankanoon.org, casemine.com, judis.nic.in, sci.gov.in
# 2. https://console.cloud.google.com → enable "Custom Search JSON API" → API key
# Without these, the Google tab opens Google.com in a new tab.
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_CSE_ID=

# ─── Indian Kanoon API (optional, for live case fetch) ────
# Register at https://api.indiankanoon.org
INDIAN_KANOON_API_TOKEN=

# ─── Supabase (NOT used by default — leave blank) ─────────
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
